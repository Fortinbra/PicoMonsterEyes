;
; Adapted from the Raspberry Pi pico-extras `audio_i2s` PIO program
; (Copyright (c) 2020 Raspberry Pi (Trading) Ltd., SPDX-License-Identifier: BSD-3-Clause)
;
; Transmits a stereo I2S audio stream, 16 bits per sample.
;
; Autopull must be enabled, with threshold set to 32. Since I2S is MSB-first,
; shift direction must be to the left. The FIFO word format is therefore:
;
;   | 31   :   16 | 15   :    0 |
;   | left sample | right sample|
;
; One output pin carries DIN. Two side-set pins carry BCLK (base) and
; LRCLK (base + 1); they must be consecutive GPIOs.

.program audio_i2s
.side_set 2

bitloop1:
    out pins, 1        side 0b10
    jmp x-- bitloop1    side 0b11
    out pins, 1         side 0b00
    set x, 14           side 0b01

bitloop0:
    out pins, 1         side 0b00
    jmp x-- bitloop0    side 0b01
    out pins, 1         side 0b10
public entry_point:
    set x, 14           side 0b11

% c-sdk {

static inline void audio_i2s_program_init(PIO pio, uint sm, uint offset, uint data_pin, uint clock_pin_base) {
    pio_sm_config sm_config = audio_i2s_program_get_default_config(offset);

    sm_config_set_out_pins(&sm_config, data_pin, 1);
    sm_config_set_sideset_pins(&sm_config, clock_pin_base);
    sm_config_set_out_shift(&sm_config, false, true, 32);
    sm_config_set_fifo_join(&sm_config, PIO_FIFO_JOIN_TX);

    pio_sm_init(pio, sm, offset, &sm_config);

    uint32_t pin_mask = (1u << data_pin) | (3u << clock_pin_base);
    pio_sm_set_pindirs_with_mask(pio, sm, pin_mask, pin_mask);
    pio_sm_set_pins(pio, sm, 0);

    pio_sm_exec(pio, sm, pio_encode_jmp(offset + audio_i2s_offset_entry_point));
}

%}
